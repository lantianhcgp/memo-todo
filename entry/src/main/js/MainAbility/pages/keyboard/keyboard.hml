<stack class="stack-container">
   <text class="boot-err" show="{{ bootErr }}">{{ bootErr }}</text>
   <div class="container anim-page" style="animation-name: {{ pg }};">
      <div class="title-item">
         <text class="title" @longpress="handleReplaceSearchSettings">&#x8f93;&#x5165;&#x5185;&#x5bb9;</text>
         <text class="title-time">{{ timeString }}</text>
      </div>
      <div class="edit-text-container">
         <text class="edit-text">{{ display }}</text>
         <div class="edit-text-caret"></div>
     </div>

   <!--Input Method-->
      <div class="im-container">

      <!--候选词推荐-->
         <div class="im-sub-container" style="height : 65px; justify-content : center; align-items : center;" @swipe="doNotSwipe" show="{{ inputMethod.show.keyboard }}">
            <div style="background-color : {{ RounderBackgroundValue.background }}; border-radius : {{ RounderBackgroundValue.radius }};width: 56px;height: 54px;margin-right: 2px;align-items: center;justify-content: center; animation-duration: 150ms; animation-name: {{ bBack }};" @click="keyboardReplaceCandidate">
               <image style="width: 48px;height: 48px;"  src="{{ '/common/image/inputMethod/icon-button-keyboard-' + inputMethod.menuType + '.png'}}"></image>
            </div>
            <div class="im-candidate-list">
               <list class="im-candidate-list" ref="candidate">
                  <list-item for="{{inputMethod.candidateArr}}" class="im-candidate-item" style="width : {{ chipW }} px;" show="{{ ! ! $item }}">
                     <input freeze="true" class="im-candidate-text" style="width : {{ chipW }} px; font-size : {{ chipFont }} px; color : #FFFFFF; background-color : {{ RounderBackgroundValue.candidateBackground}}; border-radius : {{ RounderBackgroundValue.candidateRadius}}" @click="addCandidate($item)">{{$item}}</input>
                  </list-item>
               </list>
            </div>
            <div style="background-color : {{ RounderBackgroundValue.searchBackground}}; border-radius : {{ RounderBackgroundValue.searchRadius }};width: 65px;height: 54px;margin-left: 18px; align-items: center;justify-content: center; animation-duration: 150ms; animation-name: {{ bSearch }};" @click="search">
               <image style="width: 40px;height: 40px;" src="/common/image/inputMethod/icon-button-search.png"></image>
            </div>
         </div>

      <!--输入法按键-->
         <div class="im-sub-container" style="height : 201px;
                 flex-direction : column;" show="{{ inputMethod.show.keyboard }}">

         <div class="im-button-container" show="{{ !isNumber }}">
            <div class="im-key" style="animation-name: {{ bk === 'q' ? bdn : 'pressNone' }};" @click="addLetter('q')"><text class="im-key-t">q</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'w' ? bdn : 'pressNone' }};" @click="addLetter('w')"><text class="im-key-t">w</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'e' ? bdn : 'pressNone' }};" @click="addLetter('e')"><text class="im-key-t">e</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'r' ? bdn : 'pressNone' }};" @click="addLetter('r')"><text class="im-key-t">r</text></div>
            <div class="im-key" style="animation-name: {{ bk === 't' ? bdn : 'pressNone' }};" @click="addLetter('t')"><text class="im-key-t">t</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'y' ? bdn : 'pressNone' }};" @click="addLetter('y')"><text class="im-key-t">y</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'u' ? bdn : 'pressNone' }};" @click="addLetter('u')"><text class="im-key-t">u</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'i' ? bdn : 'pressNone' }};" @click="addLetter('i')"><text class="im-key-t">i</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'o' ? bdn : 'pressNone' }};" @click="addLetter('o')"><text class="im-key-t">o</text></div>
            <div class="im-key" style="animation-name: {{ bk === 'p' ? bdn : 'pressNone' }};" @click="addLetter('p')"><text class="im-key-t">p</text></div>
         </div>
         <div class="im-button-container" show="{{ !isNumber }}">
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'a' ? bdn : 'pressNone' }};" @click="addLetter('a')"><text class="im-key-t">a</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 's' ? bdn : 'pressNone' }};" @click="addLetter('s')"><text class="im-key-t">s</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'd' ? bdn : 'pressNone' }};" @click="addLetter('d')"><text class="im-key-t">d</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'f' ? bdn : 'pressNone' }};" @click="addLetter('f')"><text class="im-key-t">f</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'g' ? bdn : 'pressNone' }};" @click="addLetter('g')"><text class="im-key-t">g</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'h' ? bdn : 'pressNone' }};" @click="addLetter('h')"><text class="im-key-t">h</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'j' ? bdn : 'pressNone' }};" @click="addLetter('j')"><text class="im-key-t">j</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'k' ? bdn : 'pressNone' }};" @click="addLetter('k')"><text class="im-key-t">k</text></div>
            <div class="im-key" style="width: 39px; animation-name: {{ bk === 'l' ? bdn : 'pressNone' }};" @click="addLetter('l')"><text class="im-key-t">l</text></div>
         </div>
         <div class="im-button-container" show="{{ !isNumber }}">
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'z' ? bdn : 'pressNone' }};" @click="addLetter('z')"><text class="im-key-t">z</text></div>
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'x' ? bdn : 'pressNone' }};" @click="addLetter('x')"><text class="im-key-t">x</text></div>
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'c' ? bdn : 'pressNone' }};" @click="addLetter('c')"><text class="im-key-t">c</text></div>
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'v' ? bdn : 'pressNone' }};" @click="addLetter('v')"><text class="im-key-t">v</text></div>
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'b' ? bdn : 'pressNone' }};" @click="addLetter('b')"><text class="im-key-t">b</text></div>
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'n' ? bdn : 'pressNone' }};" @click="addLetter('n')"><text class="im-key-t">n</text></div>
            <div class="im-key" style="width: 51px; animation-name: {{ bk === 'm' ? bdn : 'pressNone' }};" @click="addLetter('m')"><text class="im-key-t">m</text></div>
         </div>
         <!--数字模式：数据驱动。字符只放 JS 数组，不进 @click 表达式——
              hvigor 对 addLetter(';') 这类含特殊字符的表达式会报 00308018，
              而模拟器解析器放行（先例：elcton code.hml 的 for+@click）-->
         <div class="im-button-container" show="{{ isNumber }}">
            <div class="im-key" style="animation-name: {{ bk === item ? bdn : 'pressNone' }};" for="{{ (idx, item) in numRow1 }}" @click="addLetter(item)">
               <text class="im-key-t">{{ item }}</text>
            </div>
         </div>
         <div class="im-button-container" show="{{ isNumber }}">
            <div class="im-key" style="width: 39px; animation-name: {{ bk === item ? bdn : 'pressNone' }};" for="{{ (idx, item) in numRow2 }}" @click="addLetter(item)">
               <text class="im-key-t">{{ item }}</text>
            </div>
         </div>
         <div class="im-button-container" show="{{ isNumber }}">
            <div class="im-key" style="width: 51px; animation-name: {{ bk === item ? bdn : 'pressNone' }};" for="{{ (idx, item) in numRow3 }}" @click="addLetter(item)">
               <text class="im-key-t">{{ item }}</text>
            </div>
         </div>
      </div>

      <!--候选词-->
         <list class="im-sub-container" style="height : 370px;" ref="list"
               show="{{ inputMethod.show.candidate }}"
               @swipe="candidateSwipe">
            <list-item class="im-candidate-full-root-item"
                       style="height : {{ Math.ceil(inputMethod.candidateArr.length / fullCols) * 77 }};">
               <input freeze="true" class="im-candidate-full-item" style="width : {{ fullW }} px; font-size : {{ fullFont }} px; color : #FFFFFF; background-color : {{ RounderBackgroundValue.candidateBackground}}; border-radius : {{ RounderBackgroundValue.candidateRadius}}"
                      for="{{ inputMethod.show.candidate ? inputMethod.candidateArr : [] }}"
                      value="{{ $item }}" @click="addCandidate($item)"></input>
            </list-item>
         </list>

      <!--底部工具栏-->
         <div class="im-bottom-tab-container">
            <div style="background-color : {{ RounderBackgroundValue.background }}; border-radius : {{ RounderBackgroundValue.radius }};width: 56px;height: 54px;margin-right: 4px;align-items: center;justify-content: center; animation-duration: 150ms; animation-name: {{ bSet }};" @click="handleReplaceSearchSettings">
               <image style="width: 40px;height: 40px;" src="/common/image/inputMethod/icon-button-keyboard-settings.png"></image>
            </div>
            <input style="background-color : {{ RounderBackgroundValue.background }}; border-radius : {{ RounderBackgroundValue.radius }};width: 200px;height: 54px; animation-duration: 150ms; animation-name: {{ bType }};" value="{{ inputMethod.keyboardType}}" @click="switchInputMethodType"></input>
            <div style="background-color : {{ RounderBackgroundValue.background }}; border-radius : {{ RounderBackgroundValue.radius }};width: 56px;height: 54px;margin-left: 4px;align-items: center;justify-content: center; animation-duration: 150ms; animation-name: {{ bDel }};" @click="deleteLetter" @longpress="deleteAllLetter">
               <image style="width: 40px;height: 40px;" src="/common/image/inputMethod/icon-button-keyboard-delete.png"></image>
            </div>
         </div>
      </div>
   </div>
<!--Toast-->
   <div class="toast-container" if="{{ toast.show }}" style="width: {{ toast.width }} px; left: {{ toast.left }} px;">
      <text>{{ toast.text }}</text>
   </div>
</stack>