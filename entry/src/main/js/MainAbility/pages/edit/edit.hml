<div class="container" @swipe="onSwipe">
    <div class="header-bar">
        <text class="title">{{ kindTitle }}</text>
        <text class="mode-t">{{ modeTitle }}</text>
    </div>
    <div class="preview">
        <text class="preview-text" if="{{ hasText }}" >{{ previewText }}</text>
        <text class="preview-empty" if="{{ !hasText }}" >&#x8FD8;&#x6CA1;&#x5185;&#x5BB9;&#xFF0C;&#x70B9;&#x4E0B;&#x65B9;&#x300C;&#x6253;&#x5F00;&#x952E;&#x76D8;&#x300D;&#x8F93;&#x5165;</text>
    </div>
    <div class="meta-bar">
        <text class="meta-t">{{ text.length }}/{{ maxLen }} &#x5B57;</text>
        <text class="msg-t" if="{{ msg !== '' }}" >{{ msg }}</text>
    </div>
    <div class="del-bar" if="{{ showDel }}">
        <div class="del-btn" @click="onRemove"><text class="del-t">&#x5220;&#x9664;&#x8FD9;&#x6761;</text></div>
    </div>
    <div class="fill" style="height: {{ showDel ? 6 : 62 }}px;"></div>
    <div class="bottom-bar">
        <div class="nav-btn nav-btn-alt" @click="openKeyboard"><text class="nav-btn-t">&#x6253;&#x5F00;&#x952E;&#x76D8;</text></div>
        <div class="nav-btn" @click="onSave"><text class="nav-btn-t">&#x4FDD;&#x5B58;</text></div>
    </div>
</div>